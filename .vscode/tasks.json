{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: astro",
      "type": "shell",
      "command": "mise exec -- pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local.*http://localhost:4321/"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
